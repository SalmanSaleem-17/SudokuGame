# Copy to .env for local development. Do not commit real IDs if your repository is public.
#
# ADS_MODE=test        (default) Google's sample app ID and test rewarded units. Never serves real ads.
# ADS_MODE=production  Uses the IDs below. The build fails if a required ID is missing,
#                      malformed, or still one of Google's test IDs.
ADS_MODE=test

# AdMob APPLICATION ID (contains "~"). Written into AndroidManifest.xml / Info.plist at build time.
# AdMob > Apps > (your app) > App settings > App ID
ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
# Optional; only needed if you ship iOS.
ADMOB_IOS_APP_ID=

# REWARDED AD UNIT ID (contains "/"). Used at runtime to request the rewarded ad.
# AdMob > Apps > (your app) > Ad units > (rewarded unit) > Ad unit ID
ADMOB_REWARDED_UNIT_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
# Optional; only needed if you ship iOS.
ADMOB_REWARDED_UNIT_IOS=

# Development only: set to 1 to simulate rewarded ads where the native ad SDK is missing
# (Expo Go). Ignored in release builds and when ADS_MODE=production.
ADS_DEV_MOCK=0
