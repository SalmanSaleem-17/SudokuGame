{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "ADS_MODE": "test" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "ADS_MODE": "test" }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": { "ADS_MODE": "production" }
    }
  }
}
